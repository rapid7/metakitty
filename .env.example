GITHUB_OAUTH_TOKEN=

# Alternative to GITHUB_OAUTH_TOKEN above: a `username:token` pair. See src/lib/github-token.ts.
# GITHUB_BASIC_AUTH=

# Optional: how long (in minutes) to reuse each repo's cached GraphQL response in .cache/
# (gitignored, never committed) instead of hitting the GitHub API again. Set to 0
# to always fetch live. Defaults to 15.
# GITHUB_CACHE_TTL_MINUTES=15

# Optional: free API key from https://nvd.nist.gov/developers/request-an-api-key, used only as a
# fallback when OSV.dev and the fkie-cad NVD mirror don't have CVSS data for a referenced CVE.
# Not required — NVD works unauthenticated too, just with a lower rate limit.
# NVD_API_KEY=

# Optional: how long (in days) to reuse cached CVSS/advisory lookups in .cache/advisories.json.
# CVSS scores rarely change once published. Set to 0 to always re-resolve. Defaults to 7.
# ADVISORY_CACHE_TTL_DAYS=7

# Optional: how long (in minutes) to reuse the cached commit-contributor leaderboard data in
# .cache/github-contributors.json instead of re-fetching from GitHub. Unlike that cache, the
# Dashboard's historical dataset in the committed data/history/ has no TTL — it's always trusted
# as a baseline, and a live fetch only tops up what's missing/changed since its own fetchedAt.
# Set to 0 to always fetch live. Defaults to 1440.
# GITHUB_HISTORY_CACHE_TTL_MINUTES=1440

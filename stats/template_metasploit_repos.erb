<%
require 'cgi'
%>
<!DOCTYPE html>
<html>
  <head>
    <title>Metasploit Stats</title>
    <meta charset='utf-8'>
    <!-- REQUIRED -->
    <style>
      body{
        padding-top: 60px;
        font-size: 16px;
      }

      .panel-title {
        font-size: 18px;
      }

      .table {
        font-size: 15px;
      }

      .clickable-row {
        cursor: pointer;
        transition: background-color 0.2s ease;
      }

      .clickable-row:hover {
        background-color: #337ab7 !important;
        color: white;
      }

      .clickable-row:hover a {
        color: #ffffff !important;
      }

      .clickable-row.visited {
        opacity: 0.6;
        background-color: #2a2f3a !important;
      }

      .clickable-row.visited td {
        color: #999;
      }

      .clickable-row a:visited {
        color: #999;
      }

      .clickable-row.visited:hover {
        background-color: #337ab7 !important;
        color: white;
        opacity: 1;
      }

      .clickable-row.visited:hover td {
        color: white;
      }

      .clickable-row.visited:hover a {
        color: #ffffff !important;
      }

      .panel-collapse .panel-body {
        padding: 15px;
      }

      .collapse-toggle {
        cursor: pointer;
        user-select: none;
      }

      .collapse-toggle:before {
        content: "▼ ";
        font-size: 12px;
        margin-right: 5px;
        transition: transform 0.2s ease;
        display: inline-block;
      }

      .collapse-toggle.collapsed:before {
        transform: rotate(-90deg);
      }

      h4 {
        font-size: 18px;
        margin-bottom: 15px;
      }

      .panel-heading {
        cursor: pointer;
        user-select: none;
        transition: background-color 0.2s ease;
      }

      .panel-heading:hover {
        background-color: #4e5d6c !important;
        border-color: #4e5d6c !important;
        color: #ffffff !important;
      }

      .github-icon {
        float: right;
        margin-left: 10px;
        margin-right: 10px;
        color: #666;
        text-decoration: none;
        font-size: 14px;
        padding: 2px 6px;
        border-radius: 3px;
        transition: all 0.2s ease;
      }

      .github-icon:hover {
        background-color: #337ab7;
        color: white;
        text-decoration: none;
      }

      .repo-name {
        display: inline-block;
      }

      .review-badge {
        font-size: 11px;
        padding: 3px 6px;
        border-radius: 3px;
        font-weight: bold;
        white-space: nowrap;
      }

      .badge-needs-review {
        background-color: #e74c3c;
        color: #fff;
      }

      .badge-reviewed {
        background-color: #28a745;
        color: #fff;
      }
    </style>
    <link href="https://maxcdn.bootstrapcdn.com/bootswatch/3.3.5/superhero/bootstrap.min.css" rel="stylesheet" integrity="sha384-IEb1z7D4ISbz8RTKVtgjIw6KegExJgu6WdDei6Fn2xgL6f5dfyTppLEFnkFbRaxv" crossorigin="anonymous">
    <script src="assets/bootstrap/js/jquery.min.js"></script>
    <script src="assets/highcharts.js" type='text/javascript'></script>
    <script src="assets/bootstrap/js/bootstrap.min.js"></script>
    <script>
      $(document).ready(function() {
        // Accordion functionality handled by Bootstrap
      });
    </script>
    <!-- EO REQUIRED -->
  </head>
  <body>
    <!-- NAVBAR-->
    <div class="container-fluid">
      <div class="row">
        <div class="col-md-12">
          <nav class="navbar navbar-default navbar-fixed-top" role="navigation">
            <div class="navbar-header">

              <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#bs-example-navbar-collapse-1">
                 <span class="sr-only">Toggle navigation</span><span class="icon-bar"></span><span class="icon-bar"></span><span class="icon-bar"></span>
              </button> <a class="navbar-brand" href="#">Metasploit Stats</a>
            </div>

            <div class="collapse navbar-collapse" id="bs-example-navbar-collapse-1">
              <ul class="nav navbar-nav">
                <li><a href="https://docs.metasploit.com">Metasploit Docs</a></li>
                <li><a href="https://github.com/rapid7/metasploit-framework">Metasploit on Github</a></li>
              </ul>
            </div>
          </nav>
        </div>
      </div>
    </div>
    <!-- NAVBAR END-->

    <div class='container'>
      <div class='tabbable tabs-left'>
        <ul class='nav nav-pills'>
          <li>
            <%= toc %>
          </li>
        </ul>
        <div class='tab-content'>
          <div class='tab-pane active'>
            <div class='page-header'>
              <h1 class='pagination-centered'>
                Pull Requests by Repository
                <button id="clearVisitedBtn" class="btn btn-sm btn-default" style="margin-left: 20px; vertical-align: middle;" title="Clear visited PR status">
                  <span class="glyphicon glyphicon-refresh"></span> Clear Visited
                </button>
              </h1>
            </div>

            <% stat_data.each_with_index do |repo, index| %>
            <div class="panel panel-default" style="margin-bottom: 30px;">
              <div class="panel-heading" data-toggle="collapse" data-target="#collapse-<%= index %>" aria-expanded="false">
                <h3 class="panel-title">
                  <span class="repo-name"><%= repo[:name] %></span>
                  <a href="https://github.com/<%= repo[:name] %>/pulls" target="_blank" class="github-icon" onclick="event.stopPropagation();" title="Open on GitHub">🔗</a>
                  <span class="pull-right">
                    <% unreviewed_count = repo[:open_prs].count { |pr| !pr[:has_review] } %>
                    <% if unreviewed_count > 0 %>
                      <span class="badge" style="background-color: #e74c3c; color: #fff; margin-left: 5px;" title="Pull requests needing review">⚠ <%= unreviewed_count %> need<%= unreviewed_count != 1 ? '' : 's' %> review</span>
                    <% end %>
                    <span class="badge" style="background-color: <%= repo[:open_prs].length > 0 ? '#dc3545' : '#6c757d' %>; margin-left: 5px;"><%= repo[:open_prs].length %> open</span>
                    <span class="badge" style="background-color: #28a745; margin-left: 5px;"><%= repo[:closed_prs].length %> closed</span>
                  </span>
                </h3>
              </div>
              <div id="collapse-<%= index %>" class="panel-collapse collapse">
                <div class="panel-body">

                <% if repo[:open_prs].any? %>
                <h4>Open Pull Requests (<%= repo[:open_prs].length %>)
                  <button class="sort-toggle btn btn-xs btn-default" data-repo-index="<%= index %>" style="margin-left: 15px; font-size: 11px;" title="Toggle sort order">
                    <span class="glyphicon glyphicon-sort"></span> Sort: <span class="sort-mode">Needs Review</span>
                  </button>
                </h4>
                <table class="table table-striped table-condensed" data-repo-index="<%= index %>">
                  <thead>
                    <tr>
                      <th style="width: 6%">#</th>
                      <th style="width: 32%;">Title</th>
                      <th style="width: 12%;">Author</th>
                      <th style="width: 12%;">Assignees</th>
                      <th style="width: 12%;">Labels</th>
                      <th style="width: 8%;">Review</th>
                      <th style="width: 9%;">Age</th>
                      <th style="width: 9%;">Updated</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% # Sort PRs: unreviewed first, then by creation date
                    sorted_prs = repo[:open_prs].sort_by { |pr| [pr[:has_review] ? 1 : 0, -Time.parse(pr[:created_at].to_s).to_i] }
                    sorted_prs.each do |pr| %>
                    <tr class="clickable-row <%= pr[:has_review] ? '' : 'unreviewed-row' %>" 
                        data-needs-review="<%= pr[:has_review] ? 'false' : 'true' %>" 
                        data-age-days="<%= (Date.today - Date.parse(pr[:created_at].to_s)).to_i %>" 
                        onclick="window.open('<%= pr[:url] %>', '_blank');">
                      <td><a href="<%= pr[:url] %>" target="_blank" onclick="event.stopPropagation();">#<%= pr[:number] %></a></td>
                      <td><%= CGI.escapeHTML(pr[:title].to_s) %></td>
                      <td><%= CGI.escapeHTML(pr[:author].to_s) %></td>
                      <td>
                        <% if pr[:assignees] && pr[:assignees].any? %>
                          <%= pr[:assignees].map { |a| CGI.escapeHTML(a) }.join(', ') %>
                        <% else %>
                          <span style="color: #999;">unassigned</span>
                        <% end %>
                      </td>
                      <td>
                        <% (pr[:labels] || []).each do |label| %>
                          <span class="label label-default" style="margin-right: 3px; font-size: 10px;"><%= CGI.escapeHTML(label.to_s) %></span>
                        <% end %>
                      </td>
                      <td>
                        <% if pr[:has_review] %>
                          <span class="review-badge badge-reviewed"><%= pr[:comment_count] %> comment<%= pr[:comment_count] != 1 ? 's' : '' %></span>
                        <% else %>
                          <span class="review-badge badge-needs-review">⚠ Needs Review</span>
                        <% end %>
                      </td>
                      <td><%= pr[:age] %></td>
                      <td><%= pr[:updated] %></td>
                    </tr>
                    <% end %>
                  </tbody>
                </table>
                <% end %>
              </div>
            </div>
            <% end %>
          </div>
        </div>
      </div>
    </div>
    <h2>Top items this last week</h2>
    <%= accordion %>

    <script>
      // Ensure collapse indicators work properly
      $(document).ready(function() {
        $('.collapse').on('show.bs.collapse', function () {
          $(this).prev().find('.collapse-toggle').removeClass('collapsed');
        });

        $('.collapse').on('hide.bs.collapse', function () {
          $(this).prev().find('.collapse-toggle').addClass('collapsed');
        });

        // Track visited pull requests
        var visitedPRs = JSON.parse(localStorage.getItem('visitedPRs') || '[]');

        function markAsVisited(row, url) {
          if (visitedPRs.indexOf(url) === -1) {
            visitedPRs.push(url);
            localStorage.setItem('visitedPRs', JSON.stringify(visitedPRs));
          }
          $(row).addClass('visited');
        }

        // Mark already visited rows
        $('.clickable-row').each(function() {
          var url = $(this).attr('onclick').match(/window\.open\('([^']+)'/)[1];
          if (visitedPRs.indexOf(url) !== -1) {
            $(this).addClass('visited');
          }
        });

        // Track clicks on rows
        $('.clickable-row').click(function() {
          var url = $(this).attr('onclick').match(/window\.open\('([^']+)'/)[1];
          markAsVisited(this, url);
        });

        // Track clicks on links (including keyboard navigation)
        $('.clickable-row a').click(function(e) {
          var url = $(this).attr('href');
          var row = $(this).closest('.clickable-row');
          markAsVisited(row, url);
        });

        // Clear visited PRs button
        $('#clearVisitedBtn').click(function() {
          localStorage.removeItem('visitedPRs');
          visitedPRs = [];
          $('.clickable-row').removeClass('visited');
          $(this).blur(); // Remove focus from button
        });

        // Sort toggle functionality
        var sortModes = {}; // Track sort mode per repo

        $('.sort-toggle').click(function(e) {
          e.stopPropagation();
          var repoIndex = $(this).data('repo-index');
          var currentMode = sortModes[repoIndex] || 'needs-review';
          
          // Cycle through three modes: needs-review → age-asc → age-desc
          var newMode;
          if (currentMode === 'needs-review') {
            newMode = 'age-asc';
          } else if (currentMode === 'age-asc') {
            newMode = 'age-desc';
          } else {
            newMode = 'needs-review';
          }
          sortModes[repoIndex] = newMode;

          // Update button text
          var buttonText = newMode === 'needs-review' ? 'Needs Review' : 
                          (newMode === 'age-asc' ? 'Age ↑' : 'Age ↓');
          $(this).find('.sort-mode').text(buttonText);

          // Find the table for this repo
          var table = $('table[data-repo-index="' + repoIndex + '"]');
          var tbody = table.find('tbody');
          var rows = tbody.find('tr').toArray();

          // Sort rows based on mode
          rows.sort(function(a, b) {
            if (newMode === 'needs-review') {
              // Sort by needs review (true first), then by age
              var aNeedsReview = $(a).attr('data-needs-review') === 'true' ? 0 : 1;
              var bNeedsReview = $(b).attr('data-needs-review') === 'true' ? 0 : 1;
              if (aNeedsReview !== bNeedsReview) {
                return aNeedsReview - bNeedsReview;
              }
              // Secondary sort by age (newest first)
              return parseInt($(a).attr('data-age-days')) - parseInt($(b).attr('data-age-days'));
            } else if (newMode === 'age-asc') {
              // Sort by age ascending (oldest first)
              return parseInt($(b).attr('data-age-days')) - parseInt($(a).attr('data-age-days'));
            } else {
              // Sort by age descending (newest first)
              return parseInt($(a).attr('data-age-days')) - parseInt($(b).attr('data-age-days'));
            }
          });

          // Reattach rows in new order
          tbody.empty();
          $.each(rows, function(i, row) {
            tbody.append(row);
          });

          $(this).blur();
        });
      });
    </script>
  </body>
</html>

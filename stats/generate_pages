def current_directory
  File.dirname(__FILE__)
end

def build_directory
  @build_directory ||= File.join(current_directory, 'build').tap do |dir|
    Dir.mkdir(dir) unless Dir.exist?(dir)
  end
end

def cache_file_path(name)
  File.join(build_directory, name)
end

def cache_valid?(filename, max_age_hours = 24)
  # Check for command line force option
  return false if ARGV.include?('--force') || ARGV.include?('-f')

  file_path = cache_file_path(filename)
  return false unless File.exist?(file_path)

  file_age_hours = (Time.now - File.stat(file_path).mtime) / 3600.0
  file_age_hours < max_age_hours
end

def store_build_asset(name, value)
  File.binwrite(cache_file_path(name), value)
end

def load_cached_asset(name)
  File.read(cache_file_path(name)) if cache_valid?(name)
end

def should_regenerate_html?(html_filename, *dependency_files)
  return true if ARGV.include?('--force') || ARGV.include?('-f')

  html_path = cache_file_path(html_filename)
  return true unless File.exist?(html_path)

  html_mtime = File.stat(html_path).mtime

  # Check if any dependency file is newer than HTML
  dependency_files.flatten.any? do |dep_file|
    # Check if it's a template file (ends with .erb)
    if dep_file.end_with?('.erb')
      template_path = File.join(current_directory, dep_file)
      File.exist?(template_path) && File.stat(template_path).mtime > html_mtime
    else
      dep_path = cache_file_path(dep_file)
      File.exist?(dep_path) && File.stat(dep_path).mtime > html_mtime
    end
  end
end

# Cache for expensive time-series computations
@computation_cache = {}

def cached_time_series_data(cache_key, &block)
  return @computation_cache[cache_key] if @computation_cache[cache_key]
  @computation_cache[cache_key] = block.call
end

def assets_need_update?
  return true if ARGV.include?('--force') || ARGV.include?('-f')

  source_dir = File.join(current_directory, 'assets')
  target_dir = File.join(build_directory, 'assets')

  return true unless Dir.exist?(target_dir)

  # Check if any source file is newer than target
  Dir.glob(File.join(source_dir, '**/*')).any? do |source_file|
    next if File.directory?(source_file)
    relative_path = source_file.sub(source_dir + '/', '')
    target_file = File.join(target_dir, relative_path)

    !File.exist?(target_file) || File.stat(source_file).mtime > File.stat(target_file).mtime
  end
end

def erb_template_for(template_name)
  template_path = File.join(current_directory, template_name)
  template_content = File.read(template_path, encoding: 'UTF-8')
  ERB.new(template_content)
end

